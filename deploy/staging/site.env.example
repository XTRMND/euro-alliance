# The app's environment on staging (/opt/euro-alliance-staging/site.env). All variables: .env.example.
# NEXT_PUBLIC_SITE_URL is baked into the image at build time (CI passes it); this copy is for the server.

PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SITE_URL=https://staging.euro-alliance.net

# Staging is never indexed: robots.txt disallows everything and every page is noindex.
# PRODUCTION ONLY: ALLOW_INDEXING=true.
ALLOW_INDEXING=false

# Every email goes here, never to the client's inboxes. Unset in production only.
# Without SMTP_HOST, emails are only logged.
INQUIRY_EMAIL_OVERRIDE=you@example.com

# One app server, so the app runs its own background jobs.
JOBS_AUTORUN=true

# No GA4_MEASUREMENT_ID and no DEV_PAGES on staging.
