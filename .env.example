# Copy to .env and fill in. Never commit .env.

# PostgreSQL. `docker compose up -d` starts a local one with these credentials.
DATABASE_URL=postgres://euro_alliance:euro_alliance@localhost:5432/euro_alliance

# Payload: a long random string, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me

# Public base URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP for inquiry emails (provider to be confirmed).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-me
MAIL_FROM="Евро Алианс <no-reply@example.com>"

# Outside production every email goes to this address instead of the client's inboxes.
# Unset it in production only.
INQUIRY_EMAIL_OVERRIDE=you@example.com

# GA4 measurement ID. Loads only after statistics consent (PR 20).
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Media storage settings follow in PR 2, once local volume or S3-compatible storage is chosen.
