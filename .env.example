# Copy to .env and fill in. Never commit .env.

# PostgreSQL. `docker compose up -d` starts a local one with these credentials.
DATABASE_URL=postgres://euro_alliance:euro_alliance@localhost:5432/euro_alliance

# Payload: a long random string, e.g. `openssl rand -hex 32`.
PAYLOAD_SECRET=change-me

# Public base URL of the site, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMTP for inquiry emails (provider to be confirmed).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=change-me
MAIL_FROM="Евро Алианс <no-reply@example.com>"

# Outside production every email goes to this address instead of the client's inboxes.
# Unset it in production only.
INQUIRY_EMAIL_OVERRIDE=you@example.com

# Background jobs (inquiry emails with retries, nightly retention). Pick one way to run them:
# - JOBS_AUTORUN=true: the site's own process runs them (a single server only), or
# - a system cron calls the job endpoints with `Authorization: Bearer $CRON_SECRET` (README).
JOBS_AUTORUN=false
# At least 32 random characters, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# GA4 measurement ID. Loads only after statistics consent (PR 20).
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Where uploads are stored (a local volume). Defaults to ./media; /app/media in the Docker image.
MEDIA_DIR=./media

# Integration tests (`pnpm test:int`) wipe and migrate this database on every run.
TEST_DATABASE_URL=postgres://euro_alliance:euro_alliance@localhost:5432/euro_alliance_test

# Serves the dev reference pages under /dev (tokens, later the component gallery). Never in production.
DEV_PAGES=true
